{
	"name": "i18n",
	"type": "module",
	"private": true,
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"import": "./built/index.js"
		},
		"./const": {
			"types": "./built/const.d.ts",
			"import": "./built/const.js"
		},
		"./build": {
			"types": "./built/build.d.ts",
			"import": "./built/build.js"
		}
	},
	"scripts": {
		"build": "tsx ./build.ts",
		"watch": "tsx ./build.ts --watch",
		"tsd": "tsd",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm typecheck && pnpm eslint",
		"lint:fix": "pnpm eslint --fix"
	},
	"files": [
		"built"
	],
	"devDependencies": {
		"@types/node": "26.6.4",
		"@typescript-eslint/eslint-plugin": "8.71.0",
		"@typescript-eslint/parser": "8.71.0",
		"chokidar": "5.0.0",
		"esbuild": "0.28.2",
		"execa": "10.0.1",
		"nodemon": "3.1.14",
		"tsx": "4.23.15"
	},
	"dependencies": {
		"js-yaml": "5.4.2"
	}
}
